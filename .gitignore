# Wildlife monitoring station — track config only, leave all data behind.

# --- Media and capture fixtures -------------------------------------------
# Camera-original footage carries GPS metadata with the home coordinates, so
# nothing that could be a phone or camera file belongs in this repo. Git
# matches these case-sensitively (core.ignorecase is false on Linux) and
# phones write .MOV/.HEIC/.JPG in uppercase -- hence the character classes.
*.[mM][pP]4
*.[mM][oO][vV]
*.[mM][kK][vV]
*.[aA][vV][iI]
*.[mM]4[vV]
*.[wW][eE][bB][mM]
*.[mM][tT][sS]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[pP][nN][gG]
*.[hH][eE][iI][cC]
*.[hH][eE][iI][fF]
*.[dD][nN][gG]
*.[aA][aA][eE]
*.[wW][aA][vV]
*.[mM][pP]3
*.[mM]4[aA]
*.[aA][aA][cC]
*.[fF][lL][aA][cC]
*.[oO][gG][gG]
*.[oO][pP][uU][sS]

# --- Databases ------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Logs -----------------------------------------------------------------
*.log
*.log.gz
*.jsonl

# --- Frigate --------------------------------------------------------------
# Runtime state Frigate writes next to its config.
frigate/config/.jwt_secret
frigate/config/.exports
frigate/config/.timeline
frigate/config/.vacuum
frigate/config/.search_stats.json
frigate/config/model_cache/
# Frigate rewrites this whenever you save the config through the UI.
frigate/config/backup_config.yaml
# Holds HomeKit pairing keys once a device pairs.
frigate/config/go2rtc_homekit.yml

# --- BirdNET-Go -----------------------------------------------------------
# The live config carries a generated session secret and OAuth client secret.
# Track birdnet-go/config/config.yaml.example instead.
birdnet-go/config/config.yaml
birdnet-go/config/.system_id
# Downloaded at startup from the upstream model registry.
birdnet-go/config/model-catalog.json
birdnet-go/config/hls/
birdnet-go/config/sessions/
birdnet-go/config/diagnostics/
birdnet-go/data/

# --- Mosquitto ------------------------------------------------------------
mosquitto/data/

# --- Local overrides ------------------------------------------------------
.env
docker-compose.override.yml
